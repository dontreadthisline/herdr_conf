#!/bin/sh
# Launch yazi in a split pane at current pane's directory

# Resolve pane_id and cwd: query herdr first (reliable on both platforms),
# fall back to env vars (set by herdr on macOS when query fails)
pane_id="${HERDR_ACTIVE_PANE_ID:-}"
cwd="${HERDR_ACTIVE_PANE_CWD:-}"
focused=$(herdr pane list 2>/dev/null | jq -r '.result.panes[] | select(.focused==true) | "\(.pane_id)|\(.cwd)"' 2>/dev/null)
if [ -n "$focused" ]; then
  pane_id="${focused%%|*}"
  cwd="${focused##*|}"
fi
pane_id="${pane_id:-${HERDR_ACTIVE_PANE_ID:-}}"
cwd="${cwd:-${HERDR_ACTIVE_PANE_CWD:-$HOME}}"

[ -z "$pane_id" ] && exit 1

# Split pane and get new pane id
new_pane=$(herdr pane split "$pane_id" --direction down --cwd "$cwd" --focus 2>/dev/null | jq -r '.result.pane.pane_id // empty')

[ -z "$new_pane" ] && exit 1

herdr pane run "$new_pane" "exec yazi"
