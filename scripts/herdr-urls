#!/bin/sh
# Extract URLs from pane and open with fzf
# Compatible with macOS and Linux, zsh and bash

LOG="${TMPDIR:-/tmp}/herdr-urls.log"
exec > "$LOG" 2>&1
echo "=== $(date) ==="

# Find herdr and jq in PATH
HERDR_BIN=$(command -v herdr) || { echo "herdr not found in PATH"; exit 1; }
JQ_BIN=$(command -v jq) || { echo "jq not found in PATH"; exit 1; }

# Get pane with claude agent (working or idle)
pane_id=$($HERDR_BIN pane list 2>/dev/null | $JQ_BIN -r '.result.panes[] | select(.agent == "claude" and (.agent_status == "working" or .agent_status == "idle")) | .pane_id' | head -1)

echo "Using pane: $pane_id"

if [ -z "$pane_id" ]; then
    echo "No pane with claude agent found"
    exit 1
fi

# Read recent content from pane and extract URLs
urls=$($HERDR_BIN pane read "$pane_id" --source recent --lines 500 --format text 2>/dev/null | \
  grep -oE 'https?://[^[:space:]"'"'"']+' | \
  sed 's/[^a-zA-Z0-9\/:_\.\-\?=\&]*$//' | \
  sort -u)

echo "Found URLs:"
echo "$urls"

if [ -z "$urls" ]; then
    echo "No URLs found"
    exit 1
fi

# Select URL with fzf
selected=$(echo "$urls" | fzf --prompt="Open URL: " --height=40%)
echo "Selected: $selected"

if [ -n "$selected" ]; then
    # Cross-platform open
    case "$(uname -s)" in
        Darwin) open "$selected" ;;
        Linux) xdg-open "$selected" 2>/dev/null || sensible-browser "$selected" 2>/dev/null || "$BROWSER" "$selected" ;;
    esac
fi
