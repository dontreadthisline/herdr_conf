#!/bin/sh
# Open nvim in new tab at current workspace directory

# Resolve cwd: query herdr first (reliable on both platforms)
cwd="${HERDR_ACTIVE_PANE_CWD:-}"
focused_cwd=$(herdr pane list 2>/dev/null | jq -r '.result.panes[] | select(.focused==true) | .cwd // empty' 2>/dev/null)
cwd="${focused_cwd:-$cwd}"
cwd="${cwd:-$HOME}"

# Create new tab with label "vim"
result=$(herdr tab create --cwd "$cwd" --label "vim" --focus 2>/dev/null)
pane_id=$(echo "$result" | jq -r '.result.root_pane.pane_id // empty')

[ -z "$pane_id" ] && exit 1

sleep 0.3
herdr pane run "$pane_id" "exec nvim ."
